{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "declaration": false,
        "outDir": "./dist",
        "rootDir": ".."
    },
    "include": [
        "src/**/*",
        "../shared/src/**/*"
    ]
}